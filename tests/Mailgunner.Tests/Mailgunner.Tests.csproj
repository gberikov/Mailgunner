<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-targeted so the published net10.0 and net8.0 assets are both actually executed. -->
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsTestProject>true</IsTestProject>
    <!-- xunit v3 test projects are self-executing console apps. -->
    <OutputType>Exe</OutputType>
    <!-- Build the Microsoft.Testing.Platform entry point instead of xunit's own console runner,
         so `dotnet test` can drive this project (see the "test" runner opt-in in global.json). -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mailgunner\Mailgunner.csproj" />
    <ProjectReference Include="..\..\samples\Mailgunner.Sample\Mailgunner.Sample.csproj" />
  </ItemGroup>

</Project>
