<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsTestProject>true</IsTestProject>
    <!-- xunit v3 test projects are self-executing console apps. -->
    <OutputType>Exe</OutputType>
    <!-- Build the Microsoft.Testing.Platform entry point instead of xunit's own console runner,
         so `dotnet test` can drive this project (see the "test" runner opt-in in global.json). -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <!-- Supplies net48 reference assemblies so this project compiles on runners (e.g. Linux CI)
         without a .NET Framework 4.8 targeting pack installed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- net48 does not implicitly reference System.Net.Http like the SDK-style net8.0/netstandard2.0 targets do. -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- Resolves the netstandard2.0 asset of the library, exercising the #if !NET8_0_OR_GREATER branches. -->
    <ProjectReference Include="..\..\src\Mailgunner\Mailgunner.csproj" />
  </ItemGroup>

</Project>
