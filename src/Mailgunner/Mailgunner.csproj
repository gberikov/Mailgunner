<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;netstandard2.0</TargetFrameworks>
    <IsPackable>true</IsPackable>

    <!-- Validates the net10.0, net8.0 and netstandard2.0 surfaces against each other on pack, and
         against the last published version, so a breaking API change fails the pack. Bump the
         baseline to the version just released after every release. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.2.0</PackageValidationBaselineVersion>

    <!-- Transitive pinning is on repository-wide (Directory.Packages.props), which is right for
         the test projects but wrong here: it promotes any transitive that happens to have a
         PackageVersion entry into a *direct* dependency, and for a packable project that means
         publishing it in the nuspec. That is how Microsoft.Extensions.Configuration — a
         PackageVersion added for the test project — ended up in the 0.1.0 package's net8.0
         dependency group. A library's dependency list is part of its contract: to force a floor
         on a transitive (e.g. a security bump), add an explicit PackageReference above instead. -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Permitted runtime dependencies (constitution Principle I); versions centrally managed. -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Polly.Core" />
    <PackageReference Include="System.Text.Json" />
    <!-- TimeProvider (public API surface, e.g. MailgunWebhookSignature.Verify) is in-box on net8.0
         but comes from this package on netstandard2.0; declared explicitly so it is a direct,
         version-pinned dependency of the published netstandard2.0 package rather than an
         undeclared transitive of Polly.Core. -->
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Build-time-only: derives the package version from the `v*` git tag.
      PrivateAssets="all" keeps MinVer out of the published package's dependency graph.
    -->
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pack the repository README and package icon into the NuGet package. -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
